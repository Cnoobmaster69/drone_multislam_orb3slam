<?xml version="1.0"?>
<launch>

<arg name="ag_n" default="0" />
<arg name="voc" default="$(find covins_comm)/../orb_slam3/Vocabulary/ORBvoc.txt" />
<arg name="cam" default="$(find covins_comm)/../orb_slam3/Examples/RGB-D/gazebo_rgbd.yaml" />

<node pkg="ORB_SLAM3" type="RGBD" name="ORB_SLAM3_rgbd$(arg ag_n)" args="$(arg voc) $(arg cam)" output="screen"> 

    <remap from="/camera/rgb/image_raw" to="/rgb/image_raw"/>
    <remap from="/camera/depth_registered/image_raw" to="/depth/image"/>

</node>

</launch>